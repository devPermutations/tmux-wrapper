[Unit]
Description=tmuxwrapper — web terminal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/tmuxwrapper/tmuxwrapper /opt/tmuxwrapper/config.toml
WorkingDirectory=/opt/tmuxwrapper
Restart=on-failure
RestartSec=3

# Only kill the main process, not forked tmux servers/shells
KillMode=process

# Save tmux sessions before stopping (for all users with tmux)
ExecStop=/bin/bash -c 'for u in $(ps -eo user= -o comm= | grep "tmux: server" | awk "{print \\$1}" | sort -u); do su - "$u" -c "~/.tmux/plugins/tmux-resurrect/scripts/save.sh" 2>/dev/null; done'

# Needs root to setuid/setgid into target users
User=root
Group=root

# Hardening
NoNewPrivileges=no
ProtectSystem=strict
ReadWritePaths=/tmp /home
PrivateTmp=false
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_FOWNER
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
