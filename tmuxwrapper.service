[Unit]
Description=tmuxwrapper — web terminal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/tmuxwrapper/tmuxwrapper /opt/tmuxwrapper/config.toml
WorkingDirectory=/opt/tmuxwrapper
Restart=on-failure
RestartSec=3

# Only kill the main process, not forked tmux servers/shells
KillMode=process

# Session saving lives in the user unit tmux-server.service (guarded,
# sequenced before kill-server; see contrib/). A save here raced that kill
# at reboot and clobbered `last` with a 0-byte file.

# Starts as root, then drops privileges itself: a per-user helper setuids to
# the target user, the front drops to run_as (default: tmuxwrapper).
User=root
Group=root

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp
PrivateTmp=false
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
