[Unit]
Description=tmuxwrapper — web terminal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/tmuxwrapper/tmuxwrapper /opt/tmuxwrapper/config.toml
WorkingDirectory=/opt/tmuxwrapper
Restart=on-failure
RestartSec=3

# Only kill the main process, not forked tmux servers/shells
KillMode=process

# Session saving lives in the user unit tmux-server.service (guarded,
# sequenced before kill-server; see contrib/). A save here raced that kill
# at reboot and clobbered `last` with a 0-byte file.

# Needs root to setuid/setgid into target users
User=root
Group=root

# Hardening
NoNewPrivileges=no
ProtectSystem=strict
ReadWritePaths=/tmp /home
PrivateTmp=false
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_FOWNER
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
